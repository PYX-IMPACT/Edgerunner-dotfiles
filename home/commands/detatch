#!/usr/bin/env bash
# detach: run a command fully detached from this terminal.
# usage: detach <command> [args...]

if [ $# -eq 0 ]; then
    echo "usage: detach <command> [args...]" >&2
    exit 1
fi

if ! command -v "$1" > /dev/null 2>&1; then
    echo "detach: command not found: $1" >&2
    exit 127
fi

# setsid -f: new session + fork, so closing the terminal can't kill it
setsid -f "$@" < /dev/null > /dev/null 2>&1
